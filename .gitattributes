# .gitattributes
* text=auto eol=lf

*.py    text eol=lf
*.sql   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.env   text eol=lf

# Excepción a la línea base: docs/CONVENTIONS.md pide PowerShell en UTF-8 con
# BOM y CRLF. Sin esta regla, `* text=auto eol=lf` los materializaba en LF.
*.ps1   text eol=crlf

# Los ejecuta Git Bash: explícito para que ninguna regla futura los pase a CRLF.
*.sh    text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.xlsx  binary
*.xls   binary
*.docx  binary
*.zip   binary
