# .env.example
# Copia este archivo a .env y rellena los valores reales

# -----------------------------------------------------------------------------
# Sigrid API (la Function App "sigrid-api" desplegada en Azure)
# -----------------------------------------------------------------------------
SIGRID_API_BASE_URL=https://func-sigrid-dev-spaincentral-001.azurewebsites.net
SIGRID_API_FUNCTION_KEY=
SIGRID_API_DATABASE=ruesma
# Timeout HTTP por petición. 300s permite transferir batches grandes.
SIGRID_API_TIMEOUT_S=300.0
# Filas por petición HTTP por defecto. DEBE ser <= MAX_ALLOWED_ROWS de la Function App.
# El cap actual de la API es 10000. Si subes MAX_ALLOWED_ROWS en Azure (y reinicias la
# Function App), puedes subir este valor proporcionalmente.
SIGRID_API_PAGE_SIZE=10000
# Reintentos automáticos en errores transitorios (timeout, 503)
SIGRID_API_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Postgres destino del data mart
# -----------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DB=sigrid_dm
PG_USER=postgres
PG_PASSWORD=
# BBDD admin a la que el ETL se conecta para crear PG_DB si no existe.
# Por defecto 'postgres' (siempre existe en cualquier instalación estándar).
PG_ADMIN_DB=postgres

# Modo TLS de libpq. Vacío = 'require' si el host es de Azure, 'prefer' si no.
# Contra un host *.postgres.database.azure.com, poner disable/allow/prefer
# ABORTA el arranque: el endpoint es público.
PG_SSLMODE=
# 'password' (contraseña de PG_PASSWORD, que en Azure sale de Key Vault) o
# 'entra' (token de identidad gestionada). Hoy se usa 'password': el humano
# descartó habilitar Entra en el servidor compartido.
PG_AUTH_MODE=password
# true = el ETL crea PG_DB si no existe. DEBE ser false contra el servidor
# compartido de Azure, donde viven albaranes y partes.
PG_AUTO_CREATE_DB=true
# Rol de grupo al que se hace SET ROLE al abrir sesión, para que todos los
# objetos tengan el mismo propietario. Vacío en local.
PG_SET_ROLE=
# Rol de solo lectura al que se reaplican los GRANT tras cada ejecución.
# Vacío (local) = el paso apply_grants es un no-op.
PG_READONLY_ROLE=
# Esquemas sobre los que el rol de solo lectura recibe USAGE + SELECT.
PG_CONSUMPTION_SCHEMAS=mart,cierre,compras,maestro,retenciones,raw,stg,aux,_meta

# -----------------------------------------------------------------------------
# Perfil Azure (F-005) — descomentar para apuntar al datamart en la nube
#
# La base sigrid_dm vive DENTRO de psql-albaranes-rs9k2, que ya sirve a
# albaranes y partes. La crea el humano una vez con infra/sql/, nunca el ETL:
# ver docs/runbook_postgres_azure.md.
#
# PG_PASSWORD sale de Key Vault y NO se escribe aquí ni en ningún fichero del
# repositorio.
# -----------------------------------------------------------------------------
# PG_HOST=psql-albaranes-rs9k2.postgres.database.azure.com
# PG_PORT=5432
# PG_DB=sigrid_dm
# PG_USER=sigrid_dm_app
# PG_PASSWORD=
# PG_SSLMODE=require
# PG_AUTH_MODE=password
# PG_AUTO_CREATE_DB=false
# PG_SET_ROLE=sigrid_dm_etl
# PG_READONLY_ROLE=mcp_sigrid_dm_ro

# -----------------------------------------------------------------------------
# Excels auxiliares de Negocio (F-004)
#
# Cada variable admite DOS formas y el ETL decide por la forma del valor:
#
#   1. Ruta del sistema de ficheros: Windows, POSIX o de red UNC. Es la de
#      desarrollo en el puesto. En un contenedor de Azure NO existe.
#   2. URI de Azure Blob Storage:
#      https://<cuenta>.blob.core.windows.net/<contenedor>/<blob>
#      Se lee con identidad gestionada (DefaultAzureCredential); la identidad
#      que ejecuta el ETL necesita el rol 'Storage Blob Data Reader' sobre la
#      cuenta. En el puesto vale la sesión de 'az login'.
#
# NO se admiten cadenas de conexión, claves de cuenta ni tokens SAS: una URI
# con '?...' se RECHAZA al arrancar el paso. Un SAS aquí sería un secreto en
# una variable de entorno, y además caduca una noche cualquiera.
#
# Vacías las tres = el paso load_aux queda SKIPPED y run-all sigue.
# -----------------------------------------------------------------------------
AUX_EXCEL_TIPO_PARTIDA=D:/datos/aux/TipoPartida.xlsx
AUX_EXCEL_TIPO_COSTE=D:/datos/aux/TipoCoste.xlsx
AUX_EXCEL_MAPEO_PROPORCIONALES=D:/datos/aux/mapeo_proporcionales.xlsx

# Perfil Azure: los mismos ficheros en el contenedor 'aux' de la cuenta que
# crea F-003. Descomentar (y comentar los tres de arriba) para leerlos de blob.
# AUX_EXCEL_TIPO_PARTIDA=https://<cuenta>.blob.core.windows.net/aux/TipoPartida.xlsx
# AUX_EXCEL_TIPO_COSTE=https://<cuenta>.blob.core.windows.net/aux/TipoCoste.xlsx
# AUX_EXCEL_MAPEO_PROPORCIONALES=https://<cuenta>.blob.core.windows.net/aux/mapeo_proporcionales.xlsx

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
