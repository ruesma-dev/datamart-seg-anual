# config/tables_sigrid.yaml
#
# Declara qué tablas de Sigrid se extraen al esquema raw de Postgres.
#
# Cada entrada define:
#   source_table       : nombre de la tabla en Sigrid (esquema dbo)
#   target_table       : nombre destino en Postgres (esquema raw)
#   id_column          : columna usada como cursor de paginación (típicamente "ide")
#   incremental_column : columna timestamp para carga incremental (típicamente "tiemod")
#   where              : filtro SQL opcional (sin la palabra WHERE)
#   exclude_columns    : columnas binarias o pesadas que no queremos extraer
#   page_size          : filas por petición HTTP (opcional, default SIGRID_API_PAGE_SIZE).
#                        Bájalo para tablas con columnas texto/blob pesadas (ej. obrparpre.planif).
#
# El ETL determina dinámicamente los tipos consultando INFORMATION_SCHEMA.COLUMNS
# de Sigrid y los mapea a tipos Postgres. No hace falta hardcodear columnas aquí.

tables:

  - source_table: con
    target_table: con
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - ima    # imagen del concepto, binario pesado
      - tex    # texto libre largo, no lo usamos en seguimiento
    # page_size: omitido → usa default global

  - source_table: conext
    target_table: conext
    id_column: ide
    incremental_column: null   # conext no tiene tiemod estándar; refresco completo
    where: null
    exclude_columns: []

  - source_table: obr
    target_table: obr
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns: []

  - source_table: obrparpar
    target_table: obrparpar
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - tex    # descripción larga, no usada en seguimiento
      - med    # medición desglosada (binario)
      - des    # descomposición desglose (texto largo)

  - source_table: obrparpre
    target_table: obrparpre
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - tex    # descripción larga
      - med    # medición desglosada (binario pesado)
      - des    # descomposición desglose
      # planif SÍ lo necesitamos (cadena de planificación temporal)
    # planif es TEXT ilimitado; bajamos el page_size para no saturar memoria
    # de la Function App si las cadenas planif son muy largas.
    page_size: 5000

  - source_table: obrfas
    target_table: obrfas
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns: []

  - source_table: obrfasamb
    target_table: obrfasamb
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns: []
    # Fases × Ámbito. Aporta `plafec`: fecha de inicio de planificación por
    # (obride, amb, fas). El parser de la columna `planif` de obrparpre usa esta
    # fecha como ancla del mes 1; mes 2 = plafec + 1 mes, etc.

  - source_table: obrctr
    target_table: obrctr
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - tex    # descripción larga del contrato (no usamos)
      - obs    # observaciones del contrato (texto libre)
    # Contratos de obra. Aporta las fechas reales/previstas (fecreaact,
    # fecprefin, fecreaini, fecreafin, fecpreini, etc.) que en Ruesma están
    # mejor mantenidas aquí que en raw.obr. Una obra puede tener varios
    # contratos; en stg se elige el más antiguo (inicio) y el más reciente
    # con fecprefin (fin). Cruce: obrctr.obride → obr.ide.

  - source_table: cen
    target_table: cen
    id_column: ide
    incremental_column: null   # catálogo estable, refresco completo
    where: null
    exclude_columns:
      - tex    # observaciones largas si existieran
    # Centros de coste. Tabla con MUCHAS columnas según el PDF (cnaeide,
    # ctacot, calcabide, direcciones, teléfonos…) pero a nosotros nos basta
    # con ide + res para mostrar el texto en la cabecera del cierre. El ETL
    # acepta cualquier columna que venga; aquí solo evitamos texto libre.

  - source_table: auxobrtip
    target_table: auxobrtip
    id_column: ide
    incremental_column: null   # catálogo estable, refresco completo
    where: null
    exclude_columns: []
    # Tipos de obra (referenciado por obr.obrtipide).

  - source_table: auxobrcla
    target_table: auxobrcla
    id_column: ide
    incremental_column: null   # catálogo estable, refresco completo
    where: null
    exclude_columns: []
    # Clases de obra (referenciado por obr.obrclaide).

  - source_table: auxobramb
    target_table: auxobramb
    id_column: ide
    incremental_column: null   # catálogo estable, refresco completo
    where: null
    exclude_columns: []

  - source_table: auxobrtca
    target_table: auxobrtca
    id_column: ide
    incremental_column: null   # catálogo estable, refresco completo
    where: null
    exclude_columns: []
    # Catálogo de "tipos de capítulo" (CD/CI/CP/...) referenciado por
    # obrparpar.tcaide. Nos permite clasificar categorías de partida
    # directamente desde Sigrid sin depender de heurísticas sobre el
    # código del capítulo raíz.

  # ===========================================================================
  # MAESTROS para consulta externa: direcciones de obra y proveedores.
  # No intervienen en el seguimiento/cierre; alimentan el schema `maestro`.
  # ===========================================================================

  - source_table: condir
    target_table: condir
    id_column: ide
    incremental_column: null     # no consta tiemod en la doc; refresco completo
    where: null
    exclude_columns:
      - dirtex   # observaciones de la dirección (texto ilimitado)
      - eiotex   # descripción con. envío (texto ilimitado)
    # Direcciones de conceptos (1N). conide → con.ide. Como la OBRA es un `con`
    # (obr.ide = con.ide) y el PROVEEDOR también (prv.ide = con.ide), esta tabla
    # da la dirección tanto de obras como de proveedores. Campos útiles:
    # dir1, dir2, dircpo (CP), munide→auxmun, proide→auxpro, dir (completa),
    # tel, ele (email). Una entidad puede tener varias direcciones (pos/tipo).

  - source_table: obrprv
    target_table: obrprv
    id_column: ide
    incremental_column: null     # no consta tiemod en la doc; refresco completo
    where: null
    exclude_columns:
      - tex    # observaciones largas
    # Obras: Proveedores (1N). Lista de proveedores por obra.
    # Cruce: obrprv.obride → obr.ide. Trae cod (código proveedor) y
    # res (nombre proveedor). El enlace al maestro de proveedor (CIF) se
    # resolverá en stg/maestro tras verificar la clave real (probable por cod).

  - source_table: prv
    target_table: prv
    id_column: ide
    incremental_column: null     # extiende con; sin tiemod propio garantizado
    where: null
    exclude_columns: []
    # Proveedores (Propiedades de con, mismo ide). Aporta cif (CIF/NIF),
    # raz (razón social), tipsub (subcontratista). La dirección viene de
    # condir (conide = prv.ide). El nombre también está en con.res.

  - source_table: auxpro
    target_table: auxpro
    id_column: ide
    incremental_column: null   # catálogo estable, refresco completo
    where: null
    exclude_columns: []
    # Provincias. Decodifica condir.proide → res (nombre provincia).

  - source_table: auxmun
    target_table: auxmun
    id_column: ide
    incremental_column: null   # catálogo estable, refresco completo
    where: null
    exclude_columns: []
    # Municipios. Decodifica condir.munide → res (nombre municipio).

  - source_table: ctr
    target_table: ctr
    id_column: ide
    incremental_column: tiemod   # si diera error, ponlo a null (refresco completo)
    where: null
    exclude_columns:
      - tex    # texto largo
      - obs    # observaciones
    # Contratos de compra. Vínculo obra↔proveedor: ctr.obride → obr.ide,
    # ctr.entide → con/prv (proveedor). Aporta importes (totdoc, tot…).
    # Fuente de "proveedores de la obra X".
  # ===========================================================================
  # MÓDULO COMPRAS (Tandas C1/C2) — comparativos, albaranes y facturas
  #
  # NOTA SOBRE exclude_columns: todas estas tablas comparten la misma lista de
  # exclusión, que cubre TODOS los nombres de columna de tipo texto ilimitado o
  # binario que usa Sigrid en documentos (tex, med, des, obs, ima, emptex,
  # dirtex, eiotex, desesp, texcom, serdesdat, texobs, coestr).
  # Motivo: el ETL descarta esas columnas al CREAR la tabla en Postgres pero
  # las pediría en el SELECT si no se excluyen, y el COPY falla con
  # "no existe la columna X". Excluir un nombre que la tabla no tiene es
  # inofensivo (el filtro simplemente no encuentra coincidencia), así que se
  # aplica la lista completa a todas y se evita ir descubriéndolas de una en
  # una. Ninguna de esas columnas la necesitan los SQL del schema compras.
  # ctr y prv ya están arriba. dcapropar/dcfpropar NO se ingieren (vacías en
  # Ruesma: la partida viene en la propia línea dcapro.paride / dcfpro.paride).
  # Volúmenes 2026-07: dcapro 1,13M · dcfpro 1,08M · dca 305k · dcf 163k ·
  # ctrpro 241k · com 20k. Primera ingesta completa ≈ 10-15 min.
  # ===========================================================================

  - source_table: com
    target_table: com
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - tex
      - med
      - des
      - obs
      - ima
      - emptex
      - dirtex
      - eiotex
      - desesp
      - texcom
      - serdesdat
      - texobs
      - coestr
    # Comparativos de ofertas. com.obride → obra. Referenciado por
    # ctr.comide / dca.comide / dcf.comide (comparativo origen).

  - source_table: comlin
    target_table: comlin
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - tex
      - med
      - des
      - obs
      - ima
      - emptex
      - dirtex
      - eiotex
      - desesp
      - texcom
      - serdesdat
      - texobs
      - coestr
    # Detalle del comparativo (líneas por oferta).

  - source_table: comprv
    target_table: comprv
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - tex
      - med
      - des
      - obs
      - ima
      - emptex
      - dirtex
      - eiotex
      - desesp
      - texcom
      - serdesdat
      - texobs
      - coestr
    # Proveedores invitados/ofertantes del comparativo.

  - source_table: ctrpro
    target_table: ctrpro
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - tex
      - med
      - des
      - obs
      - ima
      - emptex
      - dirtex
      - eiotex
      - desesp
      - texcom
      - serdesdat
      - texobs
      - coestr
    # Líneas de contrato de compra. docide→ctr, paride (partida),
    # canser (cantidad servida), tot (importe línea sin IVA).

  - source_table: dca
    target_table: dca
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - tex
      - med
      - des
      - obs
      - ima
      - emptex
      - dirtex
      - eiotex
      - desesp
      - texcom
      - serdesdat
      - texobs
      - coestr
    # Cabecera de albarán de compra (tip=14). ctride → contrato (0 = directo).
    # Código/serie/fecha viven en con (mismo ide). Series Ruesma:
    # AC (albarán), PROF (proforma/cert. subcontrata), NTC (nota).

  - source_table: dcapro
    target_table: dcapro
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - tex
      - med
      - des
      - obs
      - ima
      - emptex
      - dirtex
      - eiotex
      - desesp
      - texcom
      - serdesdat
      - texobs
      - coestr
    page_size: 5000   # tabla grande (1,1M) con muchas columnas
    # Líneas de albarán. obride/paride EN LA LÍNEA. canfac = cantidad ya
    # facturada (base de "albaranado sin facturar"). linoriide→ctrpro con
    # docoritip=44 = trazabilidad a la línea de contrato.

  - source_table: dcf
    target_table: dcf
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - tex
      - med
      - des
      - obs
      - ima
      - emptex
      - dirtex
      - eiotex
      - desesp
      - texcom
      - serdesdat
      - texobs
      - coestr
    # Cabecera de factura de compra (tip=15). Series: FR/FRGG (factura),
    # AB/ABGG (abono, importes negativos).

  - source_table: dcfpro
    target_table: dcfpro
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - tex
      - med
      - des
      - obs
      - ima
      - emptex
      - dirtex
      - eiotex
      - desesp
      - texcom
      - serdesdat
      - texobs
      - coestr
    page_size: 5000   # tabla grande (1,1M)
    # Líneas de factura, gemela de dcapro: obride/paride propios.
    # linoriide→dcapro (docoritip=14) = factura de albarán;
    # linoriide→ctrpro (docoritip=44) = factura directa de contrato.

  - source_table: dcfprodes
    target_table: dcfprodes
    id_column: ide
    incremental_column: null   # tabla mínima (~267 filas), refresco completo
    where: null
    exclude_columns:
      - tex
      - med
      - des
      - obs
      - ima
      - emptex
      - dirtex
      - eiotex
      - desesp
      - texcom
      - serdesdat
      - texobs
      - coestr
    # Destinos de líneas de factura. Residual en Ruesma; se ingiere por
    # completitud de la trazabilidad.

  # ===========================================================================
  # MÓDULO RETENCIONES (Tanda R1) — garantías retenidas
  # Una retención se materializa como EFECTO con retide <> 0:
  #   pag → la practicamos a un PROVEEDOR   (25.124 efectos, 34,7 M€ vivos)
  #   cob → nos la practica un CLIENTE      ( 2.219 efectos, 21,9 M€ vivos)
  # La regla contractual (5 %) vive en obrctr.coegar, ya ingerido.
  # Los avales (avr/ava) NO se usan en Ruesma: no se ingieren.
  # ===========================================================================

  - source_table: cob
    target_table: cob
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns: []
    # Cobros/efectos de cliente (21.643 filas). Con retide <> 0 son las
    # retenciones que el cliente nos practica. conide → factura de venta
    # (con.tip=11), cenide → obra, fecven = devolución prevista,
    # fecrea = 0 mientras siga retenida.

  - source_table: pag
    target_table: pag
    id_column: ide
    incremental_column: tiemod
    where: null
    exclude_columns:
      - blores   # motivo de bloqueo (texto libre)
    # Pagos/efectos a proveedor (252.189 filas). Con retide <> 0 son las
    # retenciones de garantía que practicamos. conide → factura de compra
    # (con.tip=15). Misma semántica de fechas que cob.

  - source_table: rec
    target_table: rec
    id_column: ide
    incremental_column: null   # catálogo estable (2.177 filas)
    where: null
    exclude_columns: []
    # Catálogo de retenciones/recargos. Extiende con: el nombre legible está
    # en con.res, NO en rec (rec no tiene cod ni res propios).
    # El tipo dominante en Ruesma es ide=558368 (97 % de los efectos).
