# .gitignore
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
coverage.json
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.idea/
.vscode/
logs/
*.log
*.zip

# backups de configuracion
*.bak

# Huellas de estructura y metricas de vistas: son la salida del comando
# `fingerprint`, que se compara con `compare-fingerprints`. Son evidencia de
# UNA ejecucion concreta, caducan con cada rebuild de mart/cierre y pueden
# llevar agregados de negocio. No se versionan (ver progress/impl_T13_fixes_f019.md).
huella_*.csv

# >>> ARNES-BASE: bloque gestionado por el arnes. No quitar esta marca. >>>
# El instalador anade este bloque al .gitignore del proyecto si no esta ya.
.env

# Cache de suites del portero (verdes por hash de arbol; ver init.sh 7 bis).
.arnes_cache/

# Originales de docs/referencia/: al repositorio entra SOLO el Markdown.
# Convierte en mecanismo la regla dura de CLAUDE.md, para que un `git add .`
# con un PDF suelto en el arbol no lo versione por descuido.
*.pdf
*.docx
*.xlsx
*.pptx
*.doc
*.xls
*.ppt
# <<< ARNES-BASE: fin del bloque gestionado. <<<
